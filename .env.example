# Copy to .env and fill in what you have. Every key is optional; a missing key
# disables that data source and the report says so.

# Claude (business-activity research with web search). Any Anthropic credential
# the SDK understands works; this is the simplest.
ANTHROPIC_API_KEY=

# X (Twitter) API v2 app bearer token. Needed for follower counts and recent-post
# engagement. Without it the X section is skipped.
X_BEARER_TOKEN=

# CoinGecko. The public API works without a key but is heavily rate limited.
# A free Demo key lifts that. Set COINGECKO_PRO=1 if the key is a Pro key.
COINGECKO_API_KEY=
COINGECKO_PRO=0

# Telegram bot used to deliver reports (varbot notify). Create one with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server settings read by the systemd units in deploy/ (ignored by the CLI itself).
WATCH_SYMBOLS=smallest:50
ALERT_PCT=3
ALERT_SIZE=100k
SCAN_MAX_MCAP=100m
SCAN_EXTRA_ARGS=

# Where to cache HTTP responses (default .varbot-cache next to the repo).
# VARBOT_CACHE_DIR=.varbot-cache

# Set to 1 to never touch the network and read recorded fixtures instead.
# VARBOT_OFFLINE=0
